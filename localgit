#!/bin/bash
set -e

# Resolve the physical project directory even through symlinks
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
PROJECT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# Allow overriding repository location via LOCALGIT_HOME
if [ -n "$LOCALGIT_HOME" ] && [ -f "$LOCALGIT_HOME/Package.swift" ]; then
    PROJECT_DIR="$LOCALGIT_HOME"
fi

BIN="$PROJECT_DIR/.build/debug/localgit"

# Ensure the binary exists and auto-recompiles if sources have changed
if [ ! -f "$BIN" ] || [ -n "$(find "$PROJECT_DIR/Sources" -newer "$BIN" 2>/dev/null)" ]; then
    (cd "$PROJECT_DIR" && swift build -c debug >/dev/null)
fi

exec "$BIN" "$@"
