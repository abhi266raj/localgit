#!/usr/bin/env python3
"""LocalGit entrypoint script."""

import sys
import os

# Add package directory to sys.path so localgit can run directly
ROOT_DIR = os.path.dirname(os.path.abspath(__file__))
if ROOT_DIR not in sys.path:
    sys.path.insert(0, ROOT_DIR)

from localgit_harness.cli import main

if __name__ == "__main__":
    main()
